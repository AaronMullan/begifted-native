#!/bin/bash
# Headless entry point for the Sentry pipelines, invoked by launchd
# (com.begifted.sentry-autofix) on weekday mornings. Prepares dedicated bot
# clones so the runs can never touch the human working checkouts, then runs
# claude -p against the begifted-native clone: /sentry-autofix (error → PR),
# /sentry-feedback-to-jira headless (feedback → ticket), and /slack-to-jira
# sweep #bugs (Slack bug report → ticket).
set -euo pipefail

# The 01:00–04:00 launchd window keeps losing passes to machine sleep — the API
# aborts mid-response with "your computer went to sleep" and the pass exits 1
# (2026-08-21/24/25). Re-exec the whole run under caffeinate so nothing can
# idle/system-sleep mid-pass; the guard var stops an infinite re-exec loop.
if [ -z "${AUTOFIX_CAFFEINATED:-}" ]; then
  export AUTOFIX_CAFFEINATED=1
  exec caffeinate -dimsu "$0" "$@"
fi

MAIN_CHECKOUT="$HOME/development/begifted-native"
AUTOFIX_ROOT="$HOME/development/autofix"
LOG_DIR="$HOME/Library/Logs/begifted-autofix"
LOCK_DIR="$LOG_DIR/.lock"
CLAUDE_BIN="$HOME/.local/bin/claude"
AUTOFIX_TIMEOUT_SECS=3600
FEEDBACK_TIMEOUT_SECS=1200
SWEEP_TIMEOUT_SECS=1200
NOTIFY_TIMEOUT_SECS=300
REPOS=(begifted-native be-gifted)

mkdir -p "$LOG_DIR" "$AUTOFIX_ROOT"
LOG="$LOG_DIR/$(date +%Y-%m-%d).log"
exec >>"$LOG" 2>&1
echo "=== autofix run $(date '+%Y-%m-%d %H:%M:%S') ==="

notify() {
  /usr/bin/osascript -e "display notification \"$1\" with title \"Sentry autofix\"" || true
}

# The Slack DMs below go through claude -p, so an expired Claude OAuth session
# kills the alert together with the passes it should be reporting on — the run
# fails silently. A bare incoming webhook needs no Claude session; it is the
# alert path of last resort, called only when a Slack DM could not be sent.
# The URL lives in the human checkout's untracked .env.local (SLACK_WEBHOOK_URL).
SLACK_WEBHOOK_URL=$(grep '^SLACK_WEBHOOK_URL=' "$MAIN_CHECKOUT/.env.local" 2>/dev/null | cut -d= -f2- | tr -d '"') || true

webhook_alert() {
  if [ -z "${SLACK_WEBHOOK_URL:-}" ]; then
    echo "no SLACK_WEBHOOK_URL in .env.local — skipping webhook alert"
    return 0
  fi
  local text=${1//\\/\\\\}
  text=${text//\"/\\\"}
  retry 3 curl -sS -m 10 -o /dev/null -X POST -H 'Content-type: application/json' \
    --data "{\"text\":\"$text\"}" "$SLACK_WEBHOOK_URL" || echo "webhook alert failed (non-fatal)"
}

# launchd fires runs missed during sleep immediately on wake, when Wi-Fi may
# not be back yet — retry network operations instead of dying on the first
# refused connection.
retry() {
  local attempts=$1 i
  shift
  for ((i = 1; i <= attempts; i++)); do
    "$@" && return 0
    [ "$i" -lt "$attempts" ] && sleep 30
  done
  return 1
}

# macOS has no `timeout`; watchdog-kill a run if it wedges past its budget.
run_claude() {
  local prompt="$1" budget="$2" label="${3:-$1}" status=0
  echo "--- $label ($(date '+%H:%M:%S')) ---"
  "$CLAUDE_BIN" -p "$prompt" --dangerously-skip-permissions &
  local claude_pid=$!
  (
    sleep "$budget"
    echo "TIMEOUT after ${budget}s — killing claude ($prompt)"
    kill "$claude_pid" 2>/dev/null
  ) &
  local watchdog_pid=$!
  wait "$claude_pid" || status=$?
  # Reap the watchdog so bash doesn't print an async "Terminated" job notice
  # into the log.
  { kill "$watchdog_pid" && wait "$watchdog_pid"; } 2>/dev/null || true
  return "$status"
}

# API connections can drop mid-response, killing a pass within seconds; one
# retry absorbs that. Exit 143 is the watchdog's SIGTERM — the pass wedged
# rather than hit a transient error, so retrying would just double the wall
# time. The passes dedup against Jira/Slack state, so a rerun after a
# partial pass can't double-file.
run_claude_retry() {
  local status=0
  run_claude "$@" || status=$?
  if [ "$status" -ne 0 ] && [ "$status" -ne 143 ]; then
    echo "exit $status — retrying once in 30s"
    sleep 30
    status=0
    run_claude "$@" || status=$?
  fi
  return "$status"
}

# mkdir is atomic: a second run while one is in flight skips instead of
# stacking git resets and claude sessions on the same clones.
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  echo "another run holds the lock at $LOCK_DIR — skipping"
  exit 0
fi
trap 'rmdir "$LOCK_DIR"' EXIT

fail() {
  echo "FAILED: $1"
  notify "failed — see $(basename "$LOG")"
  # A failure before the end-of-run summary would otherwise never reach Slack
  # (that DM lives after the passes) — send a best-effort failure DM, and
  # never let the DM itself block the exit.
  if [ -z "${DM_SENT:-}" ]; then
    local dm_dir="$AUTOFIX_ROOT/begifted-native"
    [ -d "$dm_dir/.git" ] || dm_dir="$MAIN_CHECKOUT"
    (cd "$dm_dir" && run_claude_retry "The overnight triage run FAILED before completing: $1. The log is at $LOG. Send a Slack DM to myself — the authenticated Slack user — with one short line saying the overnight triage failed and why. Use slack_send_message to my own DM channel; a real send (not a draft) is explicitly authorized for this self-notification. Do not message anyone else or post in any channel." "$NOTIFY_TIMEOUT_SECS" "failure DM") || {
      echo "failure DM failed (non-fatal)"
      webhook_alert "Overnight triage FAILED: $1 — and the Claude-sent failure DM also failed (likely expired OAuth session; run claude /login). Log: $(basename "$LOG")"
    }
  fi
  exit 1
}

for repo in "${REPOS[@]}"; do
  clone="$AUTOFIX_ROOT/$repo"
  if [ ! -d "$clone/.git" ]; then
    echo "cloning $repo"
    git clone "git@github.com:AaronMullan/$repo.git" "$clone" || fail "clone $repo"
  fi
  retry 4 git -C "$clone" fetch origin || fail "fetch $repo"
  git -C "$clone" checkout main -q || fail "checkout main $repo"
  git -C "$clone" reset --hard origin/main -q || fail "reset $repo"
  git -C "$clone" clean -fd -q || fail "clean $repo"

  # npm ci only when the lockfile changed — installs dominate run time otherwise.
  lockhash=$(shasum "$clone/package-lock.json" | cut -d' ' -f1)
  hashfile="$clone/.autofix-lockhash"
  if [ ! -f "$hashfile" ] || [ "$(cat "$hashfile")" != "$lockhash" ]; then
    echo "npm ci in $repo (lockfile changed)"
    (cd "$clone" && npm ci --no-audit --no-fund) || fail "npm ci $repo"
    echo "$lockhash" >"$hashfile"
  fi
done

# The Sentry token lives only in the human checkout's untracked .env.local.
cp "$MAIN_CHECKOUT/.env.local" "$AUTOFIX_ROOT/begifted-native/.env.local" || fail "copy .env.local"

cd "$AUTOFIX_ROOT/begifted-native"

# The passes are independent — a wedged pass must not starve the others —
# so run all of them unconditionally and report failures together.
AUTOFIX_STATUS=0
run_claude_retry "/sentry-autofix" "$AUTOFIX_TIMEOUT_SECS" || AUTOFIX_STATUS=$?
FEEDBACK_STATUS=0
run_claude_retry "/sentry-feedback-to-jira headless" "$FEEDBACK_TIMEOUT_SECS" || FEEDBACK_STATUS=$?
SWEEP_STATUS=0
run_claude_retry "/slack-to-jira sweep #bugs" "$SWEEP_TIMEOUT_SECS" || SWEEP_STATUS=$?

find "$LOG_DIR" -name '*.log' -mtime +30 -delete || true

FAILURES=""
if [ "$AUTOFIX_STATUS" -ne 0 ]; then
  FAILURES="autofix exited $AUTOFIX_STATUS"
fi
if [ "$FEEDBACK_STATUS" -ne 0 ]; then
  FAILURES="${FAILURES:+$FAILURES; }feedback exited $FEEDBACK_STATUS"
fi
if [ "$SWEEP_STATUS" -ne 0 ]; then
  FAILURES="${FAILURES:+$FAILURES; }slack sweep exited $SWEEP_STATUS"
fi
# DM Aaron the run summary. This is the one place a real slack_send_message
# (not a draft) is authorized: it's a self-notification to the authenticated
# user, nothing a teammate sees. Runs on failure too, so a broken pass still
# surfaces in Slack; the DM itself failing must not fail the run.
OUTCOME="${FAILURES:-all passes completed}"
NOTIFY_PROMPT="Read today's overnight triage log at $LOG. Then send a Slack DM to myself — the authenticated Slack user — summarizing the run: one short line per pass (sentry-autofix, sentry-feedback-to-jira, #bugs sweep) saying what was filed/opened/archived or that it was quiet, and lead with any failures. Overall outcome: $OUTCOME. Use slack_send_message to my own DM channel; a real send (not a draft) is explicitly authorized for this self-notification. Do not message anyone else or post in any channel."
run_claude_retry "$NOTIFY_PROMPT" "$NOTIFY_TIMEOUT_SECS" "slack DM notification" || {
  echo "slack notify failed (non-fatal)"
  webhook_alert "Overnight triage: summary DM could not be sent (likely expired OAuth session; run claude /login). Outcome: $OUTCOME. Log: $(basename "$LOG")"
}
# The summary DM above already led with any failures — don't double-DM from fail().
DM_SENT=1

if [ -n "$FAILURES" ]; then
  fail "$FAILURES"
fi

notify "autofix + feedback + slack sweep complete — details in $(basename "$LOG")"
echo "=== run complete $(date '+%H:%M:%S') ==="
